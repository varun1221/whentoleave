# The service as a GraalVM native image — spec §9.6, and deliberately the last thing
# built. `service/Dockerfile` beside this one is the plain JVM jar that step 13 deploys
# and verifies over HTTP; this file compiles the same verified code a second way, and the
# README carries a cold-start number from each so the claim is measured rather than
# asserted.
#
# Two stages because native-image is a 600MB toolchain that the running service has no
# use for: it produces one statically-analysed executable with no JVM under it, so the
# runtime stage needs a libc and nothing else.
#
# Build context is the repo root, same as the jar:
#   docker build -f service/Dockerfile.native -t forecast-service:native .

FROM ghcr.io/graalvm/native-image-community:21 AS builder
WORKDIR /src

# The image is Oracle Linux trimmed to what native-image itself needs, which leaves out
# findutils — and `gradlew` shells out to xargs, so without this the build dies on the
# wrapper script before Gradle has started.
RUN microdnf install -y findutils && microdnf clean all

# Same layering as the jar image: build files first, so an ordinary source change does
# not re-download the dependency graph. sampler's build file comes along because
# settings.gradle.kts includes that project and Gradle configures it even for a
# :service task.
COPY gradlew settings.gradle.kts ./
COPY gradle gradle
COPY sampler/build.gradle.kts sampler/build.gradle.kts
COPY service/build.gradle.kts service/build.gradle.kts
RUN ./gradlew :service:dependencies --configuration runtimeClasspath --no-daemon

COPY service/src service/src

# This is the slow step — minutes, not seconds, and it wants several GB of heap. Spring's
# AOT processing runs first (a real application context, built at compile time), then
# native-image closes the world over it. `NativeHints` is what keeps the Jackson-bound
# records inside that world.
RUN ./gradlew :service:nativeCompile --no-daemon

# Distroless rather than a JRE base: there is no JVM to install. `base` carries glibc and
# zlib, which a non-static native image links against, and nothing else — no shell, no
# package manager. `nonroot` because the service never writes outside /tmp.
FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /app
COPY --from=builder /src/service/build/native/nativeCompile/forecast-service ./forecast-service

# No JAVA_TOOL_OPTIONS twin to the jar image's: there is no JVM to tune, which is the
# point. The heap is the container's, and --memory in the deploy flags stays the single
# place the limit is decided.
#
# Cloud Run injects PORT and application.yml already reads it. No secrets here either:
# the key, the origin secret, the IP hash key and the database password all arrive as
# environment variables from Secret Manager at deploy time.
ENTRYPOINT ["/app/forecast-service"]
