# Cloudflare Pages reads this file from the build output and applies the headers to
# matching paths.
#
# noindex rather than robots.txt alone: a disallowed page can still be listed in search
# results when another site links to it, because the crawler honours the disallow and
# indexes the URL anyway. This header is what says "do not list this at all", and it
# reaches crawlers that never fetch robots.txt.
/*
  X-Robots-Tag: noindex, nofollow
  # The page loads its own bundle and one JSON file, and talks to its own API, and
  # nothing else. Saying so means a stray injected script has nowhere to call home.
  #
  # connect-src names the API because the lookup panel fetches it cross-origin: without
  # it, connect-src falls back to default-src — 'self' — and the browser blocks every
  # lookup. Harmless before VITE_API_BASE is set, since nothing calls it yet.
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.whentoleave.me; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  # Referrers leak where a visitor came from. This site sends none.
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
